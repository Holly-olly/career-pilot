{
  "manifest_version": 3,
  "name": "Career Pilot",
  "version": "1.2.0",
  "description": "Send any job posting to Career Pilot for instant AI fit analysis — one click on any job board.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Career Pilot",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "https://cv-matcher-azure.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
