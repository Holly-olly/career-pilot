{
  "manifest_version": 3,
  "name": "Career Pilot Bridge",
  "version": "1.1.0",
  "description": "Send any job posting to Career Pilot with one click",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Career Pilot"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://*.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
